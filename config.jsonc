{
  // ── Concurrency / Performance ───────────────────────────────────────────────
  // Per-call LLM timeout in seconds; long meetings should use 1200+.
  "llm_timeout": 1200,
  // Polish chunk size in characters; longer transcripts are split into
  // chunks processed in parallel.
  "polish_chunk_size": 3000,
  // Polish worker concurrency (chunks called against the LLM in
  // parallel); 0 = auto (max(4, cpu_count/2)).
  "polish_max_workers": 3,

  // ── Pipeline mode ───────────────────────────────────────────────────────────
  // meeting (default, meeting minutes) | interview (interview summary)
  // | sharing (sharing summary / tech talk / best-practices walkthrough)
  "mode": "meeting",

  // ── Per-stage providers ─────────────────────────────────────────────────────
  // Speech-to-text: funasr (local, default) | openai | gemini
  "transcribe_provider": "funasr",
  // Transcript polish: codex_proxy | claude | openai | gemini
  "polish_provider": "claude",
  // Meeting notes / interview summary / sharing summary: codex_proxy | claude | openai | gemini
  "meeting_notes_provider": "claude",
  // Preferred text-completion provider order. The first provider is tried
  // normally; the next one is used after failure. The fallback is promoted
  // for the cooldown, then the primary is probed again.
  "llm_priority": ["codex_proxy", "claude"],
  // How long a failed primary provider stays out of the hot path.
  "llm_failover_cooldown_hours": 3,

  // ── Live bilingual captions (GUI recording view; fully local inference) ────
  "live_captions": {
    // Default state of the caption switch in the recording view.
    "enabled": true,
    // Main spoken language of the meeting; picks the streaming ASR model.
    //   "en" = NVIDIA Nemotron Speech Streaming EN 0.6B (sherpa-onnx int8,
    //          ~440 MB one-time download). English-first, emits real casing
    //          and punctuation.
    //   "zh" = sherpa-onnx streaming zipformer bilingual zh-en (2023) plus
    //          the FunASR refine pass below. Use it for Chinese meetings.
    // Translation runs after either one (see mt_provider below).
    "language": "en",
    // Encoder chunk for "en": 80 / 160 / 560 / 1120 ms. Each is its own
    // export (the chunk is baked into the ONNX graph). A bigger chunk is more
    // accurate but the words appear later. NVIDIA's WER figures:
    // 8.43 / 7.67 / 7.07 / 6.93 %.
    "en_chunk_ms": 560,
    // Empty = auto-download the model for "language" on first use into
    // ~/Documents/meetingscribe/models/. A path here overrides "language".
    "asr_model_dir": "",
    "mt_zh_en": "Helsinki-NLP/opus-mt-zh-en",
    "mt_en_zh": "Helsinki-NLP/opus-mt-en-zh",
    // Second pass: after a line finalizes, re-decode its audio with the
    // offline FunASR stack in the background and replace the caption
    // (fixes the streaming model's typos; costs extra RAM/CPU). Skipped for
    // English-dominant lines — that stack is a Chinese model.
    "refine": true,
    // Max segments queued for that second pass (~1.0-1.4 s each). When
    // speech outruns the re-decoder the extra segments are skipped —
    // a correction that lands 30 s late is worse than none. Every skip
    // and every completed pass is logged under [CAPTION] with its
    // duration and whether the text actually changed, so you can tell
    // whether refine earns its cost.
    "refine_max_backlog": 3,
    // Minimum refresh interval (ms) for the in-flight gray caption line;
    // raise it for a calmer display, lower it for snappier partials.
    "partial_interval_ms": 500,
    // Sentence-break (endpoint detection) thresholds, forwarded to sherpa.
    // This is THE knob for how fragmented the captions are: the less a
    // continuous speaker gets cut up, the more context each line carries
    // into the refine and batch-review passes, so both correct better. The
    // cost is that the line shows up on screen later.
    //   rule2 is the main knob — trailing silence required to end a line
    //     once some text has been decoded.
    //   rule1 applies before any text is decoded; rule3 is the hard cap on
    //     how long one line may keep growing.
    // rule2=1.2 was chosen by measurement on one 4-minute passage of
    // continuous single-speaker speech (speaker count came out as 1):
    //   0.8  (this project's old hardcoded value, more aggressive than
    //         sherpa's own default)          18 lines / 75.8 chars mean
    //   1.2  (sherpa's stock default)        14 lines / 97.6 chars mean
    //   1.6                                  14 lines / 95.4 chars mean
    // 0.8 -> 1.2 is 22% fewer lines and 29% longer ones, with total
    // characters 1365 vs 1366 — the same content cut differently, nothing
    // lost. 1.2 -> 1.6 changes the line count not at all: it has plateaued,
    // so raising it further buys nothing.
    // Fewer lines is the win that matters downstream: a review call costs a
    // measured 41.6 s fixed plus only 3.4 s per line, so removing lines is
    // worth far more than shortening them.
    // Changes need an app restart (the recognizer eats these at construction).
    // Re-measure it yourself with:
    //   python3 meetingscribe.py captions <wav> --rule2 1.6
    "endpoint": {
      "rule1_min_trailing_silence": 2.4,
      "rule2_min_trailing_silence": 1.2,
      "rule3_min_utterance_length": 20.0
    },
    // Display-layer paragraph merging: consecutive finalized lines whose
    // arrival gap is <= this many ms are shown as one paragraph (display
    // only — recognition/translation data is untouched). 0 = no merging.
    // Paragraph merging. **A speaker change is the primary break** — one
    // person's speech flows and wraps as a single block, the way Google Meet's
    // live captions read; these two are only safety valves.
    // Measured on two real sessions (1121 / 264 finalized lines), share of
    // adjacent lines that merge into the same paragraph:
    //   2500 ms  (the old default)   35% / 55%   <- visibly choppy
    //  15000 ms                      80% / 90%
    //  30000 ms                     100% / 98%
    // 0 = no merging at all (one paragraph per recognised line).
    "merge_gap_ms": 30000,
    // Hard cap on one paragraph's source length. Without it a long monologue
    // becomes one unbounded paragraph, which hurts readability and makes every
    // appended line re-render an ever-growing block.
    "merge_max_chars": 800,
    // How far back the caption panel can be scrolled, in minutes. Retention
    // is by TIME so the guarantee holds regardless of speech cadence (a row
    // count would cover 3 hours of a slow meeting but only 1.5 of a fast
    // one). 0 = no time-based eviction, history_max alone applies.
    // This is a MINIMUM: eviction runs in batches (once the overflow passes
    // ~1 minute) because dropping one row per line would shift every
    // paragraph and force a full repaint of the pane on every caption.
    "history_minutes": 180,
    // Row-count backstop for memory, not the primary limit: 12000 rows is
    // 3 hours even at an extreme 66 finalized lines/minute. Older rows get
    // dropped from the display (transcripts on disk are unaffected).
    "history_max": 12000,
    // Coalescing window (ms) for caption re-renders. Bursts of partial /
    // partial_translation / translation / refined events land several
    // times per second — this debounces them into one setHtml() per
    // window so the scrollbar stops flickering. 0 = render every event.
    // Only finalized lines reach the document: the in-flight gray line is a
    // separate widget, and the pane is patched incrementally (only the
    // changed paragraph is re-laid-out), so this window does not need to
    // grow with history_minutes.
    "render_debounce_ms": 120,
    // Tag each caption line with its audio SIDE ([我方] / [对方]), decided by
    // which source (mic vs system audio) carried more energy while the line
    // was spoken. This is a side, not an identity — one microphone can carry
    // a whole meeting room — and it is only the fallback shown until
    // speaker_id below identifies the actual person. Nothing is tagged until
    // both sources have actually been heard.
    "speaker_labels": true,
    // Periodic batch re-check, on its own worker thread. Every
    // interval_minutes the finalized lines from that window — together with
    // their current translations — go to a full-size LLM (by default the same
    // polish_provider that cleans up offline transcripts) which re-checks and
    // re-translates them with the WHOLE window as context. That context is
    // what the per-line passes structurally cannot have: only here can the
    // model see that 「拆特ops」 three lines back and 「ChatOps」 now are the
    // same term. Corrections arrive as the usual refined / translation
    // events, so lines you already read get rewritten in place.
    // Cost: one LLM call per interval while recording. Set enabled=false to
    // keep captions purely local.
    "review": {
      "enabled": true,
      // Every rewrite is written to the daily log as
      //   [CAPTION] review seg=N src: 「before」 → 「after」
      //   [CAPTION] review seg=N dst: 「before」 → 「after」
      // one line per change (unchanged lines log nothing), so a session can
      // be audited afterwards. The log is purged after 7 days.
      // SLIDING WINDOW, not a timer. Every `trigger_lines` newly finalized
      // lines, the last `window_lines` are re-checked — so each line is looked
      // at ceil(window/trigger) times, every time with MORE of what came after
      // it. That right-context is the point: a sentence is often only
      // resolvable from the two that follow it.
      //
      // Re-measured directly, with realistic line lengths, through the claude
      // CLI: a call is 14.7 s fixed + 0.69 s per line (3/5/10/20 lines →
      // 16.9/17.6/22.1/28.3 s). The 14.7 s floor is the `claude -p` process
      // itself — a prompt that only answers "OK" still takes 8.5-10 s. An
      // earlier note here claimed 41.6 s + 3.4 s per line; that came from an
      // R²=0.17 fit over 120-line batches and badly overestimates small ones.
      //
      // At the measured 2.6 finalized lines/min, window=5 + trigger=2
      // dispatches every ~46 s at ~18 s per call: a ~39 % duty cycle on one
      // thread. Raise trigger_lines to spend less; raise window_lines to give
      // the model more context per call (cheaper per line, but each line waits
      // longer for its first look).
      //
      // Concurrency was measured (3 serial claude calls 29.6 s vs 3 concurrent
      // 14.0 s) and deliberately NOT used: a concurrent batch dispatches before
      // the previous one returns, so it sees no settled `context_lines`, and
      // overlapping windows would let two in-flight calls rewrite the same row.
      "window_lines": 5,
      "trigger_lines": 2,
      // Speech stopped with fewer than trigger_lines pending: flush after this
      // many seconds, or the last few lines of every meeting go unreviewed.
      "idle_flush_secs": 20,
      // Hard ceiling on one call's line count, independent of window_lines.
      // Bound by OUTPUT tokens: the model re-emits every line, measured at
      // 42 chars/line, so 120 lines is about 5.6k in / 5.2k out — just under
      // the common 8k output ceiling.
      "max_lines": 120,
      // Total cap on the pending queue (max_lines only bounds ONE batch).
      // This is a backstop, not a tuning knob: if the provider stalls the
      // queue would otherwise grow without limit, and a correction landing 40
      // minutes after the line scrolled off screen has no value. Over the cap
      // the OLDEST rows are dropped and the log says exactly which ones
      // (seg=A..B) — no silent truncation. At the measured 5.9 lines/min
      // ingest, 240 rows tolerates roughly a 40-minute complete stall.
      // Never goes below max_lines.
      "max_buffer": 240,
      // How many already-reviewed lines to pass as read-only context. This is
      // what makes terminology consistent ACROSS batches: if batch N settles
      // on "ChatOps", batch N+1 should not independently pick 「拆特ops」
      // again. They are reference only — never re-corrected, since the user
      // already saw them corrected and rewriting them every interval would
      // make the pane churn. Input tokens only, and the fixed per-call cost
      // dominates, so a dozen reference lines is noise. 0 = off.
      "context_lines": 12,
      // Empty = use polish_provider (claude / openai / gemini).
      "provider": ""
    },
    // Voice-print speaker identification, on its own worker thread. After a
    // line finalizes, cam++ extracts a 192-dim voice print from its audio
    // (~60 ms on M2) and online-clusters it, so everyone gets their own
    // 说话人N. BOTH channels are treated alike: the several people sharing
    // the call's audio are separated, and so are several people sharing one
    // microphone in a meeting room — the channel only tints the tag (blue for
    // our side). The model is zh-CN trained but a voice print captures
    // timbre, not language, so it separates speakers in English meetings too.
    "speaker_id": {
      "enabled": true,
      // iic/speech_campplus_sv_zh-cn_16k-common, ~27 MB, auto-downloaded.
      "model": "cam++",
      // Cosine similarity for "same speaker". Lower = more merging (two
      // people may share a label), higher = more splitting (one person may
      // get several labels). Measured on cam++'s own sample voices: same
      // speaker 0.694, different speakers -0.08 / 0.01 — so 0.5 sits clear
      // of both, with margin for real VoIP audio scoring lower than clean
      // studio samples.
      "threshold": 0.5,
      // Upper bound on distinct speakers; beyond it a new voice folds into
      // the nearest known speaker instead of growing the list forever.
      "max_speakers": 8,
      // Segments shorter than this are skipped — too little audio for a
      // reliable voice print.
      "min_secs": 1.0,
      // How many segments a voice-print cluster must accumulate before it is
      // shown as a person and given a number. One segment is not evidence:
      // measured on a real 34-minute meeting, 4 of 8 clusters held exactly
      // one segment each (a cough, a keyboard tap, a one-word interjection),
      // and they used up max_speakers so genuinely new voices later got
      // folded into existing speakers. Unproven lines carry no speaker tag;
      // when a second segment joins the cluster the held lines are tagged
      // retroactively, so a real speaker loses only the delay, not the label.
      "min_segments": 2,
      // Queue cap; excess segments keep their channel-based label.
      "max_backlog": 3
    },
    // Only consulted when mt_provider = "nllb".
    "nllb": {
      "mt_model": "facebook/nllb-200-distilled-600M",
      // Dynamic int8 quantization: 2-4x faster on CPU with negligible
      // quality loss. Disable if translations look degraded.
      "mt_int8": true
    },
    // Caption translation engine.
    //   hymt    = Tencent HY-MT1.5-1.8B, a dedicated translation model (GGUF
    //             via llama.cpp, ~1.1 GB auto-download, block "hymt" below).
    //             Recommended, especially for English meetings. Measured on
    //             the same 5-minute English support call (Nemotron ASR):
    //             opus-mt cut the translation off midway on long lines
    //             (9 of 25 lost their second half) and produced
    //             「齿轮」 for "gears"; HY-MT translated every line in full,
    //             fluently, at 1.14 s/line vs 0.94 s (max ~2.5 s).
    //             Falls back to marian if llama-cpp-python / the model is
    //             missing.
    //   qwen    = local Qwen small model via llama.cpp (GGUF, auto-downloaded,
    //             ~1 GB). Hotwords from stt.funasr.hotword that appear in a
    //             caption line are injected as a keep-verbatim glossary, so
    //             domain terms survive translation. Falls back to "default"
    //             automatically when llama-cpp-python isn't installed.
    //   marian  = opus-mt Marian (default, fastest: 120-150 ms/line).
    //   nllb    = NLLB-600M (760-1200 ms/line).
    //             Measured on real meeting lines, the two trade wins on
    //             domain terminology: NLLB kept "PoC" and translated
    //             "parcels" correctly where opus-mt produced 「钻石交易市场」
    //             and 「土地」; opus-mt kept "RFP" where NLLB dropped a
    //             letter. Try both on your own audio.
    //   default = same as marian.
    // NOTE on qwen for English-source meetings: measured on 4 real English
    // caption lines, the 1.5B model returned the corrected ENGLISH as its
    // "translation" in 3 of 4 — it corrects well but does not reliably
    // translate en->zh at this size. Prefer marian/nllb for English audio.
    "mt_provider": "hymt",
    // Translate a line sentence by sentence (split on . ? ! 。 ？ ！) and cache
    // each finished sentence: while a line is still being spoken only its
    // unfinished tail is re-translated, and the final reuses what the
    // partials already translated. Also keeps every model call short —
    // opus-mt silently truncates long lines. marian / nllb / hymt only (the
    // qwen correction path needs the whole line).
    // Measured gain is small: on a conversational English call Nemotron
    // emits little sentence punctuation (run-on speech), so most lines are a
    // single unit — 6 cache hits in 5 minutes, P90 final->translation
    // 3.0 s -> 2.6 s, median unchanged. Harmless, and it pays off on
    // well-punctuated speech.
    "mt_sentence_split": true,
    "qwen": {
      "model_repo": "Qwen/Qwen2.5-1.5B-Instruct-GGUF",
      "model_file": "qwen2.5-1.5b-instruct-q4_k_m.gguf",
      // Local GGUF path; empty = auto-download model_repo/model_file into
      // ~/Documents/meetingscribe/models/ on first use.
      "model_path": "",
      "n_ctx": 2048,
      // llama.cpp thread count; 0 = auto.
      "threads": 0,
      // GPU offload layers: -1 = all (Metal on Apple Silicon — measured
      // ~170x less CPU and 4x faster per line; auto-falls-back to CPU
      // when no GPU). 0 = force CPU-only.
      "n_gpu_layers": -1,
      // Finalized lines use the combined correction+translation call
      // (prompts.caption_fix_mt): fixes homophones / broken English words
      // using recent context + the hotword list, and the corrected text
      // replaces the caption line. false = translate only.
      "correct": true,
      // GBNF grammar: llama.cpp enforces the two-line 修正/翻译 contract at
      // decode time, which structurally prevents the 1.5B model from leaking
      // prompt text or looping forever. With the grammar on, the zero-shot
      // prompt (prompts.caption_fix_mt_strict) is used instead of the
      // few-shot one — the example is what the model copies from. Older
      // llama-cpp-python builds without bounded repetition fall back to
      // prompts.caption_fix_mt automatically (logged under [CAPTION]).
      // Costs ~0.6 s per finalized line (measured 1.22 -> 1.80 s on M2
      // Metal); set false to trade the format guarantee back for speed.
      // Partial (in-flight) lines are never grammar-constrained.
      "grammar": true,
      // Only hotwords this line plausibly contains are injected as a
      // glossary — literal hits plus fuzzy near-misses (拆特ops -> ChatOps),
      // at most this many. Dumping all ~100 hotwords into every prompt is
      // what made the model apply unrelated terms.
      "glossary_max": 12
    },
    // Only consulted when mt_provider = "hymt": Tencent HY-MT1.5-1.8B, a
    // dedicated translation model (GGUF via llama.cpp, ~1.1 GB auto-download).
    // Translate-only (no ASR correction). Hotwords found in a line are passed
    // through the model card's terminology block so they stay verbatim.
    // License: Tencent HY Community License (not valid in the EU/UK/KR).
    "hymt": {
      "model_repo": "tencent/HY-MT1.5-1.8B-GGUF",
      "model_file": "HY-MT1.5-1.8B-Q4_K_M.gguf",
      // Local GGUF path; empty = auto-download into ~/Documents/meetingscribe/models/.
      "model_path": "",
      "n_ctx": 2048,
      "threads": 0,
      // -1 = full Metal offload; 0 = CPU only.
      "n_gpu_layers": -1,
      // Max hotwords injected per line (literal hits only).
      "glossary_max": 12,
      // Preceding caption sentences passed as context (the model card's
      // contextual-translation template, prompts.caption_mt_hymt_context).
      // 0 = off. Keep it off with the 1.8B model: measured with 2, it
      // translated the context too — one line's translation came back
      // carrying the previous line's content — and it was slower (median
      // final->translation 1.12 s -> 1.53 s, partial translations 207 -> 160).
      "context_lines": 0
    }
  },

  // ── Hotword auto-maintenance (Schemes A+B; writes back to
  //    stt.funasr.hotword in THIS file — no extra state files) ────────────────
  "hotwords": {
    // Extract hotwords automatically after each notes/summary generation
    // and merge them into stt.funasr.hotword (available from the NEXT
    // recording; live-caption fast mode needs an app restart).
    "auto_update": true,
    // Scheme A: rule-based mining (English acronyms / CamelCase /
    // digit-bearing terms) — no LLM cost.
    "rule_extract": true,
    // Scheme B: LLM terminology extraction (reuses meeting_notes_provider;
    // runs in the offline notes phase, never in the realtime path).
    "llm_extract": true,
    // Hotword list cap; oldest entries are evicted first (rolling vocabulary).
    //
    // Measured cost of a bigger list (same audio, padded with random Chinese
    // names up to each size):
    //   streaming sherpa: init unchanged (~1 s), decode 20x -> 15.6x realtime
    //   offline FunASR:   30 s of audio takes 11.6 s -> 14.2 s -> 15.2 s
    //                     at 100 / 1000 / 5000 terms
    // Speed is not the limit; ACCURACY is. At 5000 two-character Chinese
    // names the biasing started stealing ordinary speech: 「分眼都在那边」
    // came out as 「分眼都郑娜边」. Short pure-CJK terms are the dangerous
    // ones — entries containing ASCII, or 3+ characters, are far safer.
    // 1000 is the measured-safe ceiling; before going higher, A/B it with
    // `python3 meetingscribe.py captions <wav>`.
    "max_count": 1000
  },

  // ── Calendar linkage (Google Calendar / Notion via Claude MCP or Codex) ────
  // Reads today's events so a recording is NAMED at creation time instead of
  // renamed afterwards, and stores the event's attendees / location / links in
  // a `.meta.json` sidecar next to the .wav.
  //
  // No OAuth code here on purpose: Claude MCP uses the connector already
  // authorised in Claude Code. The personal Codex fallback uses the MCP
  // configuration already authorised in the personal Codex account.
  //
  // OFF by default: turning it on pulls colleague names into local files.
  // The sidecar lives in the recordings folder (outside this repo); mined
  // attendee names go to hotword.jsonc, which is already gitignored.
  "calendar": {
    // Flipping this on in the GUI runs the connection preflight first and
    // only commits if the Google Calendar connector answers — a broken setup
    // surfaces while you are deliberately enabling it, not before a meeting.
    "enabled": true,
    // Tried in order. Claude MCP receives --allowedTools; personal Codex is
    // invoked without `-p proxy`. You can remove or reorder either provider.
    "provider_chain": ["claude-mcp", "codex_personal"],
    // Legacy single-provider setting, used only when provider_chain is absent.
    "provider": "claude-mcp",
    // How far ahead an event may start and still count as "the current
    // meeting" when pre-selecting (minutes).
    "match_window_min": 15,
    // Per-call timeout (seconds) for the tool-enabled `claude -p`.
    // Measured: calendar ~20 s, one Notion page ~86 s.
    "timeout": 180,
    // Fetch the Notion pages linked in the event description, in the
    // background DURING recording. That placement is the point: ~86 s is free
    // against a 30-minute meeting but a visible stall in front of note
    // generation.
    "fetch_notion": true
  },

  // ── Recording devices ───────────────────────────────────────────────────────
  // Recording sample rate (Hz); ideally match the device's native rate.
  "sample_rate": 48000,
  // Recording channel count (only AudioRecorder uses this;
  // DualStreamRecorder is fixed to two streams).
  "channels": 3,
  // Output device switched to at recording start
  // (null = auto-detect Multi-Output Device). To pin a specific name,
  // run `python3 meetingscribe.py devices` and copy one from the list.
  "output_record": null,
  // Output device restored after recording stops
  // (null = auto-detect the pre-recording default output).
  "output_restore": null,
  // System-audio capture device (null = auto-detect BlackHole).
  "device_system_audio": null,
  // Microphone device (null = auto-detect, external mics preferred).
  "device_mic": null,

  // ── Speech-to-text (STT) provider config ────────────────────────────────────
  "stt": {
    "funasr": {
      // Parallel instance count: 0 = auto (max(2, cpu_count/2));
      // >0 = explicit; memory usage scales linearly.
      "workers": 3,
      // Auto-chunk + parallel-transcribe when audio is longer than this
      // (seconds); 0 = always serial.
      "chunk_secs": 300,
      // ASR model; downloaded on first run (~400 MB).
      "model": "paraformer-zh",
      // Voice-activity-detection model (sentence splitting on long audio).
      "vad_model": "fsmn-vad",
      // Punctuation restoration model.
      "punc_model": "ct-punc",
      // Speaker diarization (voice-print clustering). Empty = off.
      // "cam++" = on: transcript lines become [12.3s] [说话人1] … and the
      // polish / notes prompts keep the speaker attribution.
      // COST: speaker ids are only consistent within one generate() call, so
      // turning this on disables chunked parallel transcription — a long
      // recording runs single-pass and takes roughly `workers` times longer.
      "spk_model": "",
      // Hotwords (space-separated); boosts recognition of proper nouns
      // (e.g. "sandbox API网关 AI agent Kong GKE"). Shared by batch
      // transcription AND live captions (captions pick up changes after an
      // app restart).
      //
      // LEAVE THIS EMPTY. The live list lives in hotword.jsonc, which is
      // NOT in version control: the "hotwords" block above mines new terms
      // from every meeting, so the list accumulates colleague names,
      // customer names and internal codenames — local data that must not
      // ship with the project. Copy hotword.jsonc.example to hotword.jsonc
      // and it takes over from here; a value left inline below still works
      // but gets moved out automatically on the next extraction.
      "hotword": "",
      // Filter applied to hotwords BEFORE they reach FunASR's acoustic
      // biasing (jieba word frequency cutoff). This affects the FunASR path
      // only — offline transcription and the caption refine pass. The live
      // captions' sherpa recognizer and every LLM prompt still get the full
      // list, where the terms demonstrably do work.
      //
      // Measured on 11 slices (~440 s) of one real meeting, full 682-term
      // list against none: 9 slices byte-identical, ZERO terms newly
      // recognised, and 2 slices where a CORRECT word got corrupted.
      // Splitting the list explained it — English-only scored a similarity of
      // exactly 1.0000 (no effect at all), while CJK-only turned 「前面」 into
      // 「成本」.
      //
      // So English is dropped outright: FunASR's seg_tokenize maps any word
      // missing from the model's 305k-entry English sub-word dictionary to
      // <unk>, which is 95 of 471 terms here and includes precisely the
      // valuable ones (CockroachDB, ClickHouse, BigQuery, ChatOps, N4D).
      // CJK terms encode fine character-by-character and are kept, minus
      // everyday vocabulary: biasing cannot help there (the model already
      // gets those right) and can only steal an acoustically similar
      // neighbour. 成本 scores 4289 and was the observed offender; 容灾 /
      // 压测 / 冷热存储 / colleague names are absent from jieba's dictionary
      // entirely, which is exactly the class that needs biasing.
      //
      // 1000 keeps 206 of 211 CJK terms, dropping 成本 黄金 转化 合同 拦截.
      // Lower it if you still see substitutions; 0 disables the filter.
      "hotword_common_cutoff": 1000
    },
    "openai": {
      "api_key": "",
      "model": "whisper-1",
      "base_url": "https://api.openai.com/v1"
    },
    "gemini": {
      "api_key": "",
      "model": "gemini-2.0-flash"
    }
  },

  // ── Text-processing (LLM) provider config ───────────────────────────────────
  // Fallback chain tried, in order, when the primary LLM provider fails with a
  // timeout, a non-zero exit, or a usage limit. Applies to TEXT-COMPLETION
  // calls only: transcript polish, meeting / interview / sharing notes, hotword
  // extraction and the live-caption batch review.
  //
  // Calendar / Notion fetching has its own provider_chain because Claude MCP
  // and personal Codex need different CLI invocation rules.
  //
  // A user-initiated cancel (停止任务) never triggers a fallback.
  // Set to [] to restore the old behaviour of failing on the first error.
  "llm_fallback": ["claude"],

  "llm": {
    "claude": {
      // claude-cli shells out to the locally installed Claude Code CLI
      // (`claude -p <prompt>`).
      "type": "claude-cli",
      // Optional: pin a specific claude-cli model
      // (empty string = use the CLI's own default).
      "model": ""
    },
    "codex_proxy": {
      // The local Codex CLI (`codex -p proxy exec`), using the proxy profile
      // in ~/.codex/proxy.config.toml.
      // Measured: 8.8 s for a trivial prompt and 13.0 s for a real polish
      // chunk (timestamps stripped, "big query" -> BigQuery, one clean
      // paragraph) — the same order as `claude -p`. The answer is read from
      // `-o <file>` because `codex exec` streams agent progress to stdout.
      "type": "codex-cli",
      // Primary model for text completion. Keep this explicit so fallback
      // order does not depend on whichever model the proxy profile selects.
      "model": "gpt-5.6-sol",
      // If the selected model is at capacity or its usage is exhausted, try
      // these models in order.
      "models": ["gpt-5.6-terra", "gpt-5.6-luna", "gpt-5.5"],
      "profile": "proxy",
      // Extra command-line arguments, appended verbatim.
      "args": [],
      // Its OWN timeout, deliberately shorter than llm_timeout: a fallback
      // must not hold a worker for the primary's generous budget.
      // Measured through the proxy: trivial prompt 8.4 s, polish chunk 13 s,
      // a 5-line caption_review batch 17.2 s — so 300 s is a failure ceiling,
      // not a working budget.
      "timeout": 300
    },
    "codex_personal": {
      // Plain `codex exec` using the personal Codex account. Do not change
      // this to the proxy profile if Calendar / Notion should use personal
      // MCP connections.
      "type": "codex-cli",
      "model": "",
      "models": [],
      "profile": "",
      "args": [],
      "timeout": 300
    },
    "openai": {
      "type": "openai",
      "api_key": "",
      "model": "gpt-4o",
      "base_url": "https://api.openai.com/v1"
    },
    "gemini": {
      "type": "gemini",
      "api_key": "",
      "model": "gemini-1.5-pro"
    }
  },

  // ── Advanced audio options (rarely need to change) ──────────────────────────
  "audio": {
    // AudioDeviceMonitor safety wakeup interval (seconds). Self-heal
    // cap for when the HAL listener stops delivering events —
    // hot-plug events normally drive the monitor and this never fires.
    // Drop to 5 while debugging hotplug.
    "monitor_safety_timeout_sec": 30.0,
    // Device names matched when auto-detecting the Multi-Output Device
    // (Simplified Chinese / Traditional Chinese / English). If you
    // renamed your Multi-Output Device in Audio MIDI Setup, add the new
    // name here to restore auto-detection.
    "multi_output_device_names": [
      "Multi-Output Device", "多输出设备", "多重輸出裝置"
    ],
    // While recording, watch for apps that play straight into BlackHole
    // instead of through the Multi-Output (some iPad-style apps land on the
    // aggregate's clock-master sub-device), which leaves you hearing
    // nothing. When one is found, BlackHole is forwarded live to your
    // current headphones / speakers. Checked when recording starts and
    // whenever CoreAudio reports an app starting, stopping or switching its
    // output (no polling). macOS 14.2+.
    "passthrough_bypass": true
  },

  // ── Pipeline prompt templates ───────────────────────────────────────────────
  // [PROJECT RULE] Every prompt MUST live here as an editable block;
  //   maintaining prompts only in code is forbidden.
  //   Rationale: prompts are the main lever for product behaviour and
  //   ops / business / non-Python contributors must be able to tune
  //   them without reading Python. The `_PROMPT_DEFAULTS` dict in
  //   meetingscribe.py is fallback only — never the sole source.
  //   When adding a new mode you MUST also add its prompt block here.
  //
  // Edit any prompt below to customise the AI's behaviour.
  //
  //   • polish    — proofread / clean the raw transcript (parallel,
  //                 chunked). **Mode-independent.**
  //   • hotwords_extract — mine ASR hotwords from the polished transcript
  //                 after notes generation (Scheme B of the hotword
  //                 automation; results merge into stt.funasr.hotword).
  //                 **Mode-independent.**
  //   • caption_mt — live-caption translation prompt for the Qwen backend
  //                 (live_captions.mt_provider = "qwen"). **Mode-independent.**
  //   • caption_fix_mt — live-caption ASR-correction + translation combo
  //                 prompt (Qwen backend, finalized lines only).
  //                 **Mode-independent.**
  //   • meeting   → notes_zh / notes_en — meeting minutes (Chinese / English)
  //   • interview → notes_zh / notes_en — interview report (Chinese / English)
  //   • sharing   → notes_zh / notes_en — sharing summary / tech talk /
  //                 best-practices walkthrough (Chinese / English)
  //
  // Each prompt is a **string array** — joined on "\n" at load time.
  // JSON forbids literal newlines inside strings, so the array form is
  // the conventional way to keep multi-line prompts readable. A single
  // string is also accepted.
  //
  // Placeholders are case-sensitive literal substitutions; other curly
  // braces do not need escaping. `{transcript}` is the only placeholder
  // for hotwords_extract; polish and notes_* additionally take `{hotwords}`
  // (the current stt.funasr.hotword list, injected automatically — the
  // notes step needs it to resolve the 【？】 markers polish leaves behind).
  // With calendar linkage on, polish also takes `{roster}` (the event's
  // attendees, which is what lets it put real names on [说话人N]) and notes_*
  // take `{context}` (the linked Notion pages as background). Both render as
  // 「（无）」 when there is no sidecar, so the prompts work unchanged without
  // the calendar feature.
  // caption_mt / caption_fix_mt use `{src_lang}` / `{dst_lang}` /
  // `{glossary}` / `{text}` (+ `{context}` for caption_fix_mt) instead.
  // Delete the whole "prompts" block or any single key to fall back to
  // the built-in defaults in the code.
  "prompts": {
    "polish": [
      "你是一位专业的文字校对助手，正在处理一段录音的自动转写文本（可能来自会议、面试或其他场景）。",
      "",
      "以下是语音识别自动转写的文本，带有时间戳，可能存在错别字、同音字混淆、断句不当等问题。",
      "",
      "请在**不改变原意**的前提下：",
      "1. 去掉所有时间戳（如 [00.0s]）",
      "2. 将所有片段合并为连贯的自然段落，按语义分段",
      "3. 纠正明显的错别字和同音字错误；专有名词优先按【术语表】还原，大小写和连写方式照抄表内写法（如 sars → SaaS、拆特ops → ChatOps）",
      "4. 修复错误的断句和标点",
      "5. 删除重复内容——语音识别可能对相邻片段重复识别同一句话，检查前后句子，去掉重复的短语或句子",
      "6. 【？】只用于**结合上下文和术语表仍然无法确定**的内容。凡是已经能确定的——尤其是按术语表修正过来的词——直接写正确写法，**不要再加【？】**；一份转写里【？】越少越有价值，满篇都是标记等于没标",
      "7. 同一个说法在全文只能有一种写法：若同一个词在不同位置被识别成不同的形式，统一成最可能正确的那一个，不要一处 SARS 一处 SaaS",
      "8. 如能可靠区分不同发言者，请在段落前标注角色或姓名（如「面试官：」/「候选人：」/「主持人：」/具体姓名）；若无法可靠区分则不要强行标注",
      "9. 若某行带 [说话人N] 前缀（声纹聚类结果），必须保留发言人区分：同一个 N 视为同一个人，可结合上下文把它替换成姓名或角色（如「说话人2」→「候选人」）；不要把不同 N 合并成一个人，也不要因为整理段落而丢掉发言人标注",
      "",
      "【术语表】以下是本场景常出现的专有名词（转写中与其发音相近的错误词请优先修正为表内写法；表内没有的不要强行替换）：",
      "{hotwords}",
      "- 表里的**人名**只用于还原发音高度吻合的整个名字。不要给转写里已经成立的名字补字（「韩磊」不要改成「韩磊磊」），也不要把一串普通词句凑成表里的人名（「下来……继续」不是人名）。拿不准就保留转写原样。",
      "",
      "【本场参会人】以下名单来自日历（可能不全，也可能有人没发言）：",
      "{roster}",
      "- 转写里与名单中某人发音相近的人名，优先按名单写法还原。",
      "- 若第 9 条的 [说话人N] 能结合上下文对应到名单里的某个人（例如自我介绍、被别人称呼），就把 [说话人N] 换成那个人的名字；对应不上的保持 [说话人N] 原样，**不要猜**。",
      "- 名单是参会人，不是发言人：名单里的人不一定说过话，也不要因为名单有 N 个人就硬凑出 N 个说话人。",
      "",
      "只输出整理后的正文，不要解释修改内容。",
      "",
      "---",
      "【原始转写】",
      "{transcript}"
    ],
    // Scheme B hotword mining: runs after each notes generation (offline
    // phase, never in the realtime caption/recording path). The parsed
    // terms merge into stt.funasr.hotword above.
    "hotwords_extract": [
      "你是一个语音识别热词提取助手。请从下面的文本中提取值得加入 ASR 热词表的词条，用于提升后续录音转写对专有名词的识别准确率。",
      "",
      "提取范围：产品名、项目名、公司名、团队名、人名、技术术语、英文缩写、中英混合词（如 API网关）。",
      "",
      "要求：",
      "1. 只输出热词本身，全部放在同一行，词与词之间用单个空格分隔",
      "2. 每个热词内部不能含空格；英文多词术语拆成单个单词分别输出",
      "3. 优先选择语音识别容易写错的词，不要输出常见普通词汇",
      "4. 最多 30 个；一个都没有时输出空行",
      "5. 不要输出任何解释、编号、标点或其他内容",
      "",
      "---",
      "【文本】",
      "{transcript}"
    ],
    // Live-caption translation prompt for the Qwen backend
    // (live_captions.mt_provider = "qwen"). Placeholders: {src_lang} /
    // {dst_lang} (中文/英文), {glossary} (hotword keep-verbatim
    // instruction, may be empty), {text} (the caption line). The
    // Marian / NLLB backends are not prompt-driven and ignore this.
    "caption_mt": [
      "你是专业的同声传译引擎。请把下面这句{src_lang}口语翻译成{dst_lang}，保持口语化、简洁、自然；只输出译文，不要任何解释或标注。{glossary}",
      "",
      "【原文】",
      "{text}"
    ],
    // Combined ASR-correction + translation prompt for the Qwen caption
    // backend (FINALIZED lines only, gated by live_captions.qwen.correct;
    // in-flight partials keep using caption_mt). Placeholders: {src_lang}
    // / {dst_lang} (中文/英文), {glossary} (hotword instruction, may be
    // empty), {context} (previous finalized lines for discourse context),
    // {text} (the caption line). Output must be two lines 修正：/翻译：.
    "caption_fix_mt": [
      "你是实时字幕的校对与同声传译引擎。输入是一句{src_lang}流式语音识别结果，可能有同音字错误或残缺的英文单词。",
      "规则：",
      "- 只修正确定的识别错误（同音字、残缺英文词），修正后的词要与原词发音相近；不确定的保持原样；不改写语义、不增删内容、不替换人名",
      "- 「修正」行必须仍是{src_lang}（修正后的完整原文，不是翻译，不能丢掉任何分句）；「翻译」行才是{dst_lang}译文，口语化、简洁",
      "{glossary}",
      "上文语境（仅供理解，不要输出）：",
      "{context}",
      "",
      "输出格式示例（严格两行，无其他内容）：",
      "修正：预算下周才能确认，我们先把接口文档写完",
      "翻译：The budget won't be confirmed until next week; let's finish the API docs first.",
      "",
      "【原文】",
      "{text}"
    ],
    // Zero-shot twin of caption_fix_mt, used when live_captions.qwen.grammar
    // is on: the GBNF grammar pins the two-line format at decode time, so the
    // format example is dropped — a 1.5B model copies example wording into
    // its own output, and few-shot underperforms zero-shot at this size.
    // Same placeholders and same 修正：/翻译： contract. When the grammar
    // can't be built (older llama-cpp-python), caption_fix_mt above is used
    // instead — there the example is what keeps the format honest, so keep
    // both blocks in sync when editing the rules.
    "caption_fix_mt_strict": [
      "你是实时字幕的校对与同声传译引擎。输入是一句{src_lang}流式语音识别结果，可能有同音字错误或残缺的英文单词。",
      "规则：",
      "- 只修正确定的识别错误（同音字、残缺英文词），修正后的词要与原词发音相近；不确定的保持原样；不改写语义、不增删内容、不替换人名",
      "- 「修正」行必须仍是{src_lang}（修正后的完整原文，不是翻译，不能丢掉任何分句）；「翻译」行才是{dst_lang}译文，口语化、简洁",
      "{glossary}",
      "上文语境（仅供理解，不要输出）：",
      "{context}",
      "",
      "先输出「修正：」行，再输出「翻译：」行；两行之外不要输出任何内容。",
      "",
      "【原文】",
      "{text}"
    ],
    // Live-caption translation prompt for the HY-MT1.5 backend
    // (live_captions.mt_provider = "hymt"). This is Tencent's own template
    // from the model card — HY-MT is a dedicated translation model trained on
    // this wording, so keep edits minimal. Placeholders: {dst_lang}
    // (中文/英文), {glossary} (「参考下面的翻译：X 翻译成 X」 block for the
    // hotwords this line contains, may be empty), {text} (the caption line).
    "caption_mt_hymt": [
      "{glossary}将以下文本翻译为{dst_lang}，注意只需要输出翻译后的结果，不要额外解释：",
      "",
      "{text}"
    ],
    // Contextual variant for the HY-MT backend, used when
    // live_captions.hymt.context_lines > 0 and there is preceding speech:
    // the model card's own contextual-translation template. Placeholders:
    // {glossary}, {context} (previous caption sentences, source language),
    // {dst_lang}, {text}.
    "caption_mt_hymt_context": [
      "{glossary}{context}",
      "参考上面的信息，把下面的文本翻译成{dst_lang}，注意不需要翻译上文，也不要额外解释：",
      "{text}"
    ],
    // Periodic batch re-check of live captions (live_captions.review).
    // Placeholders: {hotwords} (current stt.funasr.hotword list), {lines}
    // (numbered "N ||| 原文 ||| 当前译文"). Output contract parsed by
    // _parse_caption_review: one line per entry, "N ||| 修正后的原文 ||| 译文".
    // Entries the model omits or mangles leave that caption untouched.
    "caption_review": [
      "你是会议实时字幕的校对助手。下面是最近一段会议的流式识别字幕，按顺序编号，每条包含识别原文和当前译文。流式识别常有同音字错误、残缺英文单词、错误断句，译文也会因此跟着错。",
      "",
      "请结合**整段上下文**和术语表，逐条给出修正后的原文与译文：",
      "1. 只修正确定的识别错误（同音字、残缺或拼错的英文词、明显错词）；不确定的保持原样",
      "2. 不要改写语气或风格，不要合并或拆分条目，不要增删内容——条数必须与输入完全一致",
      "3. 人名、产品名、技术术语优先采用术语表中的写法",
      "4. 译文必须与修正后的原文对应：中文原文译成英文，英文原文译成中文；口语化、简洁",
      "5. 只有当一整行几乎没有标点、读起来是连成一串时，才在**行内**补上必要的逗号；不要给本来就通顺的行添加或改动标点，也绝不能跨行合并或拆分",
      "6. 无需修改的条目也要原样输出",
      "7. 术语和人名的写法必须与【上文】保持一致——同一个词在前文已确定的写法，本批不要再换一种写法",
      "",
      "【术语表】（转写中与其发音相近的错误词请优先修正为表内写法；表内没有的不要强行替换）",
      "{hotwords}",
      "",
      "【上文】（本场前面已经校对完成的字幕，只作理解上下文和统一术语之用；不要输出这部分，也不要修改它们）",
      "{context}",
      "",
      "【字幕】（只校对并输出这一部分）",
      "{lines}",
      "",
      "严格按下面格式输出，每行一条，除此之外不要输出任何内容：",
      "编号 ||| 修正后的原文 ||| 译文"
    ],
    "meeting": {
      "notes_zh": [
        "你是一位专业的会议纪要助手。请根据以下转写文本生成结构化会议纪要。",
        "",
        "要求：",
        "1. **会议概要** — 2~3 句话概括核心内容",
        "2. **主要议题** — 逐条列出讨论的关键议题",
        "3. **决策事项** — 明确达成的决定或共识，整节合并为一个 `> [!important]` callout 块，条目在块内用列表罗列",
        "4. **行动项** — 格式：负责人 · 事项 · 截止时间（负责人或截止时间无明确信息则标\"待确认\"），整节合并为一个 `> [!tip]` callout 块，条目在块内用列表罗列",
        "5. **关键洞察** — 值得记录的重要观点",
        "6. **风险与提醒** — 会议中提到的风险、阻塞点或需特别注意的事项，整节合并为一个 `> [!warning]` callout 块，条目在块内用列表罗列；无则省略本节",
        "",
        "callout 语法示例（每节只用一个 callout：标记行 + 列表条目，每行都以 > 开头；不要为每个条目单独开 callout）：",
        "> [!important]",
        "> - 确定采用方案 B，下季度上线。",
        "> - 数据迁移窗口定在 9 月第一周。",
        "",
        "行动项的取材与归属（这一节最容易出错，请严格遵守）：",
        "- 每条行动项都必须能在转写里找到对应原话。找不到出处的一条都不要写——行动项少是正常的，编出来的不是。",
        "- 顺口提到的意向或客套（如「我到时候给你过一下」）只有在会上明确约定了要做时才算行动项。",
        "- 负责人只能是转写里**被明确点名指派**、或**本人明确认领**的人。转写没有说话人标注时，无主语的「我」「他」不得推断成任何具体的人。",
        "- 定不下负责人就写「待确认」，不要从术语表或参会人名单里挑一个看起来合理的人补上。",
        "",
        "【术语表】本场景的专有名词（转写里与之发音或拼写相近的词请统一成表内写法；表内没有的不要强行替换）：",
        "{hotwords}",
        "- 术语表是**拼写参照，不是本场人员名单**：里面的人名大多与本场无关。不要用表里的名字去补全转写中没出现的人，也不要给转写里已经成立的名字补字（「韩磊」→「韩磊磊」）。",
        "",
        "【本场参会人】以下名单来自本场关联的日程（可能不全，也可能有人没发言；显示为「（无）」时表示没有关联日程，本节规则忽略）：",
        "{roster}",
        "- 行动项的负责人一般应出自这份名单。",
        "- 也确实存在名单外的人被安排事项的情况：只要转写里明确点到了这个人，就照写他的名字，并在负责人后注明「（非参会人，会上被提及）」。",
        "- 名单是参会人，不是发言人：不要因为某人在名单里就给他安排事项，更不要因为名单有 N 个人就凑出 N 个负责人。",
        "- 名单内外都对不上，或转写没有明确指派时，负责人写「待确认」。",
        "",
        "术语与不确定标记：",
        "- 转写里的【？】是上一步校对没能确定的内容。只要结合术语表、上下文或转写其他位置的写法能够确定，就直接写确定的写法并**删掉【？】**；只有确实无法确定的才保留标记。",
        "- 同一个实体全文只用一种写法，不要一处写 SARS、一处写 SaaS。",
        "",
        "中文排版：",
        "- 加粗的引导词后面接说明内容时用冒号：写「**背景：**……」，不要写「**背景。**……」；只有加粗部分本身就是一个完整句子时才用句号。",
        "- 中文正文只用中文标点：并列用「、」，分句用「；」，句末用「。」，引述原话用「」；不要在中文里使用半角的 \" . ,。",
        "- 中文与英文单词、数字之间留一个空格。",
        "",
        "【会议背景资料】以下内容来自本场日程关联的 Notion 文档，仅供你理解背景、对齐术语和人名：",
        "{context}",
        "- 这些是**会前材料，不是会上说过的话**。绝不能把这里的内容写成会议结论、决议或行动项。",
        "- 只在转写本身提到某件事、而表述残缺或有歧义时，才用它来补全术语写法和上下文。",
        "- 如果背景资料与转写内容冲突，以**转写**为准。",
        "",
        "用中文输出，格式为 Markdown，简洁清晰。若内容较短或不完整，如实说明。",
        "",
        "---",
        "【会议转写】",
        "{transcript}"
      ],
      "notes_en": [
        "You are a professional meeting notes assistant. Based on the following meeting transcript, generate structured meeting notes in English.",
        "",
        "Requirements:",
        "1. **Meeting Summary** — 2–3 sentences summarizing the core content",
        "2. **Key Topics** — list each major topic discussed",
        "3. **Decisions Made** — explicit decisions or consensus reached, merged into one `> [!important]` callout block with a bullet list inside",
        "4. **Action Items** — format: Owner · Task · Due Date (mark \"TBD\" for an owner or a due date the transcript does not settle), merged into one `> [!tip]` callout block with a bullet list inside",
        "5. **Key Insights** — notable observations worth recording",
        "6. **Risks & Reminders** — risks, blockers, or points needing special attention, merged into one `> [!warning]` callout block with a bullet list inside; omit this section if none",
        "",
        "Callout syntax example (one callout per section: marker line + list items, every line starts with >; do NOT open a separate callout per item):",
        "> [!important]",
        "> - Adopt option B; ship next quarter.",
        "> - Data migration window: first week of September.",
        "",
        "Sourcing and ownership of action items (the easiest section to get wrong — follow strictly):",
        "- Every action item must trace back to actual words in the transcript. If you cannot point to the passage, do not write the item — a short list is normal; an invented one is not.",
        "- A passing intention or a courtesy (\"I can walk you through it sometime\") counts as an action item only if the session explicitly agreed it would be done.",
        "- An owner may only be someone the transcript **explicitly assigns** or who **explicitly takes it on**. When the transcript carries no speaker labels, a subjectless \"I\" or \"he\" must not be resolved to any particular person.",
        "- If the owner cannot be settled, write \"TBD\". Never pick a plausible-looking name out of the glossary or the attendee list.",
        "",
        "[Glossary] Domain terms for this session. Normalise transcript words that are near-homophones or misspellings of a glossary entry to the glossary spelling; do not force-replace anything absent from the list:",
        "{hotwords}",
        "- The glossary is a **spelling reference, not a roster for this session** — most of the names in it have nothing to do with this meeting. Never use a glossary name to fill in a person the transcript does not mention, and never extend a name the transcript already states (韩磊 → 韩磊磊).",
        "",
        "[Attendees] The list below comes from the calendar event linked to this session (it may be incomplete, and some invitees may never have spoken; when it reads \"（无）\" there is no linked event and this section does not apply):",
        "{roster}",
        "- An action item's owner should normally come from this list.",
        "- People outside the list do occasionally get assigned something: where the transcript clearly names such a person, keep their name and append \"（非参会人，会上被提及）\" after it.",
        "- The list is attendees, not speakers: never assign work to someone merely because they are on it, and never manufacture N owners because the list has N people.",
        "- When nobody on or off the list can be settled on, and where the transcript makes no explicit assignment, write \"TBD\".",
        "",
        "Terminology and uncertainty markers:",
        "- 【？】 in the transcript marks something the proofreading step could not confirm. Wherever the glossary, the surrounding context, or another passage settles it, write the confirmed form and **drop the marker**; keep 【？】 only where it genuinely stays unresolved.",
        "- Use one spelling per entity throughout — never SARS in one paragraph and SaaS in another.",
        "",
        "[Background material] The following comes from the Notion pages linked to this session's calendar event. Use it only to understand context and to get terminology and names right:",
        "{context}",
        "- This is **pre-reading, not something anyone said in the session.** Never report it as a decision, conclusion or action item.",
        "- Draw on it only where the transcript itself raises a point but states it incompletely or ambiguously.",
        "- Where the background and the transcript disagree, the **transcript** wins.",
        "",
        "Output in English, Markdown format, concise and clear. If the content is short or incomplete, state so honestly.",
        "",
        "---",
        "[Meeting Transcript]",
        "{transcript}"
      ]
    },
